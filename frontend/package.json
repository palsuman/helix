{
  "name": "helix-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "icons:brand": "node scripts/build-brand-icons.mjs",
    "dev": "node scripts/build-icons.mjs && vite",
    "build": "node scripts/build-icons.mjs && npm run i18n:check && npm run lint && tsc -b && vite build",
    "tauri:dev": "node ../scripts/prepare-kernel-sidecar.mjs debug && cd ../crates/helix-supervisor && ../../frontend/node_modules/.bin/tauri dev",
    "tauri:build": "node ../scripts/prepare-kernel-sidecar.mjs release && cd ../crates/helix-supervisor && ../../frontend/node_modules/.bin/tauri build",
    "test:ipc-e2e": "node ../scripts/run-ipc-e2e.mjs",
    "e2e:build": "node ../scripts/build-e2e.mjs",
    "test:e2e": "wdio run e2e/wdio.conf.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:extract": "node scripts/extract-messages.mjs",
    "i18n:check": "node scripts/extract-messages.mjs --check",
    "test:eslint-rules": "node eslint-rules/no-user-visible-literals.test.js",
    "test:a11y": "vitest run --config vitest.config.ts src/test/accessibility.test.tsx",
    "test": "npm run test:eslint-rules && vitest run --config vitest.config.ts",
    "test:coverage": "npm run test:eslint-rules && vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@tauri-apps/api": "2.11.1",
    "monaco-editor": "0.52.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intl": "10.1.26",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@formatjs/cli": "6.16.23",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wdio/cli": "9.31.6",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.6",
    "@wdio/mocha-framework": "9.31.6",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "axe-core": "4.11.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0",
    "webdriverio": "9.31.6"
  }
}
